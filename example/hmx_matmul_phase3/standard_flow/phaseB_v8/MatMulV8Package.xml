<?xml version="1.0" encoding="UTF-8"?>
<!--
  V8 custom-op package — minimum-viable OpDef so qnn-onnx-converter
  / qairt-converter can emit the 4-node graph and the HTP backend can
  call our existing libQnnHmxMatMulPhase3_htp.so kernels.

  Package-name MUST match the existing OpPackage's interface provider
  (HmxMatMulPhase3InterfaceProvider / THIS_PKG_NAME=HmxMatMulPhase3Package)
  so that at runtime the converter-emitted nodes resolve to our kernels.
-->
<OpDefCollection
        PackageName="HmxMatMulPhase3Package"
        Domain="hmx"
        Version="1.0"
>
    <OpDefList>
        <!-- ============================================================
             PackActivationU8RowMajor
             in:  act_raw [1,1,M,K]  u8
             out: packed  [1, M/32, K/32, 1024]  u8
             ============================================================ -->
        <OpDef>
            <Name>PackActivationU8RowMajor</Name>
            <Description><Content>HVX pack u8 activation DDR→VTCM row-major 1 KiB tiles.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Description><Content>activation u8 [1,1,M,K]</Content></Description>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,M,K]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Description><Content>packed u8 [1, M/32, K/32, 1024]</Content></Description>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, K/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             PackWeightToHmxTileV3
             in:  wt_raw [1,1,K,N]  i8 (declared u8 to skip QNN Cast+128)
             out: packed [1, N/32, K/32, 1024]  u8
             ============================================================ -->
        <OpDef>
            <Name>PackWeightToHmxTileV3</Name>
            <Description><Content>HVX pack i8 weight into HMX P2-layout tiles.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,K,N]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, N/32, K/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             MatMulV8  (HMX-only, writes tile-layout output)
             in[0]: packed_act  u8  [1, M/32, K/32, 1024]
             in[1]: packed_wt   u8  [1, N/32, K/32, 1024]
             in[2]: bias_fp16   u16 [1, 1, N/32, 128]  (per-col scale+baseline)
             in[3]: scratch     u8  [1, 1, 1, 2048]    (VTCM scratch)
             out:   out_tile    u8  [1, M/32, N/32, 1024]
             ============================================================ -->
        <OpDef>
            <Name>MatMulV8</Name>
            <Description><Content>HMX-only quantized matmul replica of QNN ConvLayer_s1.opt.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, K/32, 1024]</Text></Shape>
            </Input>
            <Input>
                <Name>in[1]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, N/32, K/32, 1024]</Text></Shape>
            </Input>
            <Input>
                <Name>in[2]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,N/32,128]</Text></Shape>
            </Input>
            <Input>
                <Name>in[3]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,1,2048]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, N/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             BbbKMajor — V10/Route1 matmul, native-aligned 3-input form.
             in[0]: u8  act    [1, M/32, 32, K]      Crouton_8 via QNN
             Phase C-1 (2026-04-30) reordered: bias first to match native VTCM
             layout (bias=0xfc020000 / wt=0xfc020800 / act=0xfc030800).
             in[0]: i32 bias   [N]                   raw int32 STATIC
                              (QNN inserts q::ConvLayer.opt.bias_to_vtcm)
             in[1]: u8  wt     [1, K/32, N/32, 1024] pre-packed native layout
             in[2]: u8  act    [1, M/32, 32, K]      Crouton_8 dynamic
             in[3]: u8  scratch [1,1,1,2048] STATIC zero, TCM_Only —
                              backing store for runtime act_tbl_all/out_tbl_all
                              so kernel reads pointer tables from VTCM.
             out:   u8        [1, M/32, 32, N]      Crouton_8 (Step 3)
                              QNN auto-inserts q::ForceFormat_Flat
                              + framework Output → user row-major DDR
             ============================================================ -->
        <OpDef>
            <Name>BbbKMajor</Name>
            <Description><Content>K-major Crouton matmul, Phase C-1 reordered (bias-first).</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, N/32, 1, 64]</Text></Shape>
            </Input>
            <Input>
                <Name>in[1]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, 1, K, N]</Text></Shape>
            </Input>
            <Input>
                <Name>in[2]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, 32, K]</Text></Shape>
            </Input>
            <Input>
                <Name>in[3]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, 1, 1, 2048]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, 32, N]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             PackActCrouton — V10 Route 1 production activation pack.
             Wraps libQnnHtpV75Skel.so::convert_to_crouton_b.
             in[0]: u8 [1,1,M,K]   M%4==0, K%128==0
             out[0]: u8 [1, K/32, M/32, 1024]   Crouton blocks contiguous
             ============================================================ -->
        <OpDef>
            <Name>PackActCrouton</Name>
            <Description><Content>HVX Crouton-byte activation pack via QNN skel export.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,M,K]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, K/32, M/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             CroutonPackSpike — Phase 1 dlsym test op.
             Calls libQnnHtpV75Skel.so::convert_to_crouton_b on a fixed
             32×128 u8 input, compares against C reference, returns stats.
             in[0]: u8 [1,1,32,128]
             out[0]: u8 [1,1,4,1024]   skel-call output (4 Crouton blocks)
             out[1]: u8 [1,1,1,4]      [skel_done, ref_done, n_diffs, max_diff]
             ============================================================ -->
        <OpDef>
            <Name>CroutonPackSpike</Name>
            <Description><Content>Phase 1 spike op — dlsym test.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,32,128]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,4,1024]</Text></Shape>
            </Output>
            <Output>
                <Name>out[1]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,1,4]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             UntileToRowMajor — VTCM tile-layout → DDR row-major output
             in:  [1, M_t, N_t, 1024]  u8
             out: [1, 1, M_t*32, N_t*32]  u8 row-major
             ============================================================ -->
        <OpDef>
            <Name>UntileToRowMajor</Name>
            <Description><Content>Tile-layout VTCM → row-major DDR output.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M_t, N_t, 1024]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, 1, M_t*32, N_t*32]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             TcmDramCopy — bulk HVX vmem VTCM→DDR pass-through (same shape)
             ============================================================ -->
        <OpDef>
            <Name>TcmDramCopy</Name>
            <Description><Content>Bulk HVX vmem copy tile-layout VTCM buffer to DDR.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[*, *, *, 1024]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>same as in[0]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>
    </OpDefList>

    <SupplementalOpDefList Backend="HTP">
        <SupportedOps>
            <OpName>PackActivationU8RowMajor</OpName>
            <OpName>PackWeightToHmxTileV3</OpName>
            <OpName>MatMulV8</OpName>
            <OpName>TcmDramCopy</OpName>
            <OpName>CroutonPackSpike</OpName>
            <OpName>PackActCrouton</OpName>
            <OpName>BbbKMajor</OpName>
            <OpName>UntileToRowMajor</OpName>
        </SupportedOps>

        <SupplementalOpDef>
            <Name>PackActivationU8RowMajor</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>PackWeightToHmxTileV3</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>MatMulV8</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Input><Name>in[1]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Input><Name>in[2]</Name><Datatype>QNN_DATATYPE_UINT_16</Datatype></Input>
            <Input><Name>in[3]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>TcmDramCopy</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>BbbKMajor</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_INT_32</Datatype><Datatype>QNN_DATATYPE_SFIXED_POINT_32</Datatype></Input>
            <Input><Name>in[1]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Input><Name>in[2]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Input><Name>in[3]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>UntileToRowMajor</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>PackActCrouton</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>CroutonPackSpike</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
            <Output><Name>out[1]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
    </SupplementalOpDefList>

</OpDefCollection>
