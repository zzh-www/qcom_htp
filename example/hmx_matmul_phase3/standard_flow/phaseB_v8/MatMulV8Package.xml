<?xml version="1.0" encoding="UTF-8"?>
<!--
  V8 custom-op package — minimum-viable OpDef so qnn-onnx-converter
  / qairt-converter can emit the 4-node graph and the HTP backend can
  call our existing libQnnHmxMatMulPhase3_htp.so kernels.

  Package-name MUST match the existing OpPackage's interface provider
  (HmxMatMulPhase3InterfaceProvider / THIS_PKG_NAME=HmxMatMulPhase3Package)
  so that at runtime the converter-emitted nodes resolve to our kernels.
-->
<OpDefCollection
        PackageName="HmxMatMulPhase3Package"
        Domain="hmx"
        Version="1.0"
>
    <OpDefList>
        <!-- ============================================================
             PackActivationU8RowMajor
             in:  act_raw [1,1,M,K]  u8
             out: packed  [1, M/32, K/32, 1024]  u8
             ============================================================ -->
        <OpDef>
            <Name>PackActivationU8RowMajor</Name>
            <Description><Content>HVX pack u8 activation DDR→VTCM row-major 1 KiB tiles.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Description><Content>activation u8 [1,1,M,K]</Content></Description>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,M,K]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Description><Content>packed u8 [1, M/32, K/32, 1024]</Content></Description>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, K/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             PackWeightToHmxTileV3
             in:  wt_raw [1,1,K,N]  i8 (declared u8 to skip QNN Cast+128)
             out: packed [1, N/32, K/32, 1024]  u8
             ============================================================ -->
        <OpDef>
            <Name>PackWeightToHmxTileV3</Name>
            <Description><Content>HVX pack i8 weight into HMX P2-layout tiles.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,K,N]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, N/32, K/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             MatMulV8  (HMX-only, writes tile-layout output)
             in[0]: packed_act  u8  [1, M/32, K/32, 1024]
             in[1]: packed_wt   u8  [1, N/32, K/32, 1024]
             in[2]: bias_fp16   u16 [1, 1, N/32, 128]  (per-col scale+baseline)
             in[3]: scratch     u8  [1, 1, 1, 2048]    (VTCM scratch)
             out:   out_tile    u8  [1, M/32, N/32, 1024]
             ============================================================ -->
        <OpDef>
            <Name>MatMulV8</Name>
            <Description><Content>HMX-only quantized matmul replica of QNN ConvLayer_s1.opt.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, K/32, 1024]</Text></Shape>
            </Input>
            <Input>
                <Name>in[1]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, N/32, K/32, 1024]</Text></Shape>
            </Input>
            <Input>
                <Name>in[2]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,N/32,128]</Text></Shape>
            </Input>
            <Input>
                <Name>in[3]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1,1,1,2048]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[1, M/32, N/32, 1024]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>

        <!-- ============================================================
             TcmDramCopy — bulk HVX vmem VTCM→DDR pass-through (same shape)
             ============================================================ -->
        <OpDef>
            <Name>TcmDramCopy</Name>
            <Description><Content>Bulk HVX vmem copy tile-layout VTCM buffer to DDR.</Content></Description>
            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>[*, *, *, 1024]</Text></Shape>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape><Rank>4D</Rank>
                <Layout>NONTRIVIAL</Layout><Text>same as in[0]</Text></Shape>
            </Output>
            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>
    </OpDefList>

    <SupplementalOpDefList Backend="HTP">
        <SupportedOps>
            <OpName>PackActivationU8RowMajor</OpName>
            <OpName>PackWeightToHmxTileV3</OpName>
            <OpName>MatMulV8</OpName>
            <OpName>TcmDramCopy</OpName>
        </SupportedOps>

        <SupplementalOpDef>
            <Name>PackActivationU8RowMajor</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>PackWeightToHmxTileV3</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>MatMulV8</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Input><Name>in[1]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Input><Name>in[2]</Name><Datatype>QNN_DATATYPE_UINT_16</Datatype></Input>
            <Input><Name>in[3]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
        <SupplementalOpDef>
            <Name>TcmDramCopy</Name>
            <Input><Name>in[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Input>
            <Output><Name>out[0]</Name><Datatype>QNN_DATATYPE_UINT_8</Datatype><Datatype>QNN_DATATYPE_UFIXED_POINT_8</Datatype></Output>
        </SupplementalOpDef>
    </SupplementalOpDefList>

</OpDefCollection>
